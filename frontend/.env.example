# URL base de la API (backend FastAPI). Solo se admite una ruta (/api) o una URL http(s) sin credenciales.
# En desarrollo local (si se omite, se usa http://localhost:8000):
VITE_API_URL=http://localhost:8000
# En producción, si se omite se usa /api (mismo origen, proxy de nginx).
# Docker Compose construye la imagen con VITE_API_URL=/api.
